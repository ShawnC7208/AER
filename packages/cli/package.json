{
  "name": "@aer/cli",
  "version": "0.5.0",
  "description": "AER command-line tools.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnC7208/AER.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ShawnC7208/AER#readme",
  "bugs": {
    "url": "https://github.com/ShawnC7208/AER/issues"
  },
  "keywords": ["agent", "audit", "cli", "jsonl", "aer"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aer": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "aer": "pnpm build && node dist/index.js"
  },
  "dependencies": {
    "@aer/adapter-claude-code": "workspace:*",
    "@aer/core": "workspace:*",
    "@aer/viewer": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
