{
  "name": "@aer/viewer",
  "version": "0.4.0",
  "description": "Static, deterministic HTML renderer for AER records.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnC7208/AER.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://github.com/ShawnC7208/AER#readme",
  "bugs": {
    "url": "https://github.com/ShawnC7208/AER/issues"
  },
  "keywords": ["agent", "audit", "html", "viewer", "aer"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aer/core": "workspace:*"
  },
  "devDependencies": {
    "@aer/adapter-claude-code": "workspace:*",
    "esbuild": "^0.21.5",
    "vitest": "^2.1.8"
  }
}
