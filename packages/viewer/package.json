{
  "name": "@aer/viewer",
  "version": "0.1.0",
  "description": "Static AER viewer placeholder.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aer/core": "workspace:*"
  },
  "devDependencies": {
    "@aer/adapter-claude-code": "workspace:*",
    "esbuild": "^0.21.5",
    "vitest": "^2.1.8"
  }
}
